# ============================================================
# Python
# ============================================================

# Python virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class


# ============================================================
# Environment variables / secrets
# ============================================================

.env
.env.*
!.env.example


# ============================================================
# AWS / credentials
# ============================================================

.aws/
credentials


# ============================================================
# AWS Lambda build artifacts
# ============================================================

# Locally installed dependencies used to build Lambda Layer
lambda-layer/

# Generated Lambda Layer ZIP
cloudops-ai-boto3-layer.zip

# Backup created before RAG integration
backend/lambda/lambda_handler.py.pre-rag

# Other generated Lambda ZIP packages
*.zip


# ============================================================
# macOS
# ============================================================

.DS_Store


# ============================================================
# IDE / Editor
# ============================================================

.vscode/
.idea/

*.swp
*.swo
*~


# ============================================================
# Testing / coverage
# ============================================================

.pytest_cache/
.coverage
htmlcov/


# ============================================================
# Logs
# ============================================================

*.log
logs/


# ============================================================
# Terraform
# ============================================================

# Terraform local working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Local Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IMPORTANT:
# .terraform.lock.hcl is intentionally NOT ignored.
# We will commit the provider lock file when we build Terraform.


# ============================================================
# Local temporary files
# ============================================================

*.tmp
